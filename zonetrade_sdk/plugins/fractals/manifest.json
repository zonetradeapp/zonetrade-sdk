{
  "slug": "fractals",
  "version": "0.1.0",
  "apiVersion": 1,
  "name": "Fractals (server)",
  "description": {
    "ru": "SMC свинги (HH/HL/LH/LL/SH/SL)",
    "en": "SMC swings (HH/HL/LH/LL/SH/SL)",
    "uk": "SMC свінги (HH/HL/LH/LL/SH/SL)"
  },
  "tier": "free",
  "author": "zonetrade-core",
  "algorithmParamKeys": ["fractalN", "respectInsideCandles"],
  "paramsSchema": {
    "fractalN": {
      "type": "number",
      "default": 2,
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Fractal N (1=3-bar, 2=5-bar)"
    },
    "respectInsideCandles": {
      "type": "boolean",
      "default": true,
      "label": "Respect inside bars"
    },
    "colorHH": {
      "type": "color",
      "default": "rgba(34,197,94,0.95)",
      "label": "HH color"
    },
    "colorHL": {
      "type": "color",
      "default": "rgba(34,197,94,0.85)",
      "label": "HL color"
    },
    "colorLH": {
      "type": "color",
      "default": "rgba(239,68,68,0.95)",
      "label": "LH color"
    },
    "colorLL": {
      "type": "color",
      "default": "rgba(239,68,68,0.85)",
      "label": "LL color"
    },
    "colorSH": {
      "type": "color",
      "default": "rgba(148,163,184,0.9)",
      "label": "SH color"
    },
    "colorSL": {
      "type": "color",
      "default": "rgba(148,163,184,0.9)",
      "label": "SL color"
    },
    "radius": {
      "type": "number",
      "default": 3,
      "min": 1,
      "max": 10,
      "step": 1,
      "label": "Marker radius"
    },
    "showLabel": {
      "type": "boolean",
      "default": true,
      "label": "Show label"
    }
  }
