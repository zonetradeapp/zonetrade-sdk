{
  "slug": "three-drive",
  "version": "0.1.0",
  "apiVersion": 1,
  "name": "3-Drive (server)",
  "description": {
    "ru": "3-drive setup поверх фракталов (LL/LL/LL или HH/HH/HH с прогрессией)",
    "en": "3-drive setup on top of fractals (LL/LL/LL or HH/HH/HH progression)",
    "uk": "3-drive сетап поверх фракталів (LL/LL/LL або HH/HH/HH з прогресією)"
  },
  "tier": "free",
  "author": "zonetrade-core",
  "dependsOn": ["fractals"],
  "algorithmParamKeys": ["fractalN", "respectInsideCandles", "minDriveGapPct", "lookback"],
  "paramsSchema": {
    "fractalN": {
      "type": "number",
      "default": 2,
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Fractal N (passed to fractals plugin)"
    },
    "respectInsideCandles": {
      "type": "boolean",
      "default": true,
      "label": "Respect inside bars (passed to fractals plugin)"
    },
    "minDriveGapPct": {
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 5,
      "step": 0.1,
      "label": "Min drive gap %"
    },
    "lookback": {
      "type": "number",
      "default": 10,
      "min": 3,
      "max": 30,
      "step": 1,
      "label": "Lookback window (fractals)"
    },
    "colorLong": {
      "type": "color",
      "default": "rgba(34,197,94,0.95)",
      "label": "Long 3-drive color"
    },
    "colorShort": {
      "type": "color",
      "default": "rgba(239,68,68,0.95)",
      "label": "Short 3-drive color"
    },
    "radius": {
      "type": "number",
      "default": 4,
      "min": 1,
      "max": 10,
      "step": 1,
      "label": "Marker radius"
    },
    "showLabel": {
      "type": "boolean",
      "default": true,
      "label": "Show label"
    }
  }
}
